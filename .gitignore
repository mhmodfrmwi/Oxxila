logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Local overrides
*.local

# Test & coverage
coverage/
.nyc_output/

# Caches
.cache/
.turbo/
.vite/
.eslintcache

# Vercel
.vercel/

# OS files
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# Editor & IDE
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.code-workspace

# Cursor (local IDE/agent config — do not publish)
.cursor/

