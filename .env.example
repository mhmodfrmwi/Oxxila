# Same-origin API path — proxied in dev (Vite) and on Vercel (vercel.json rewrites).
VITE_API_BASE_URL=/api/v1

# Backend OAuth redirects (must match these frontend routes):
# OAUTH_SUCCESS_REDIRECT=https://oxxila-ashy.vercel.app/home  (token in URL hash: #accessToken=…)
# OAUTH_FAILURE_REDIRECT=https://oxxila-ashy.vercel.app/login?error=google_failed
