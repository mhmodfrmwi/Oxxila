# Dev uses Vite proxy (/api/v1) to avoid CORS. Restart `npm run dev` after changing this.
VITE_API_BASE_URL=/api/v1

# OAuth: API redirects with ?accessToken=... or ?error=...
# Set backend FRONTEND_URL to your app /login or /home (token is handled on any route).
# Local:  http://localhost:5173/login
# Prod:   https://oxxila-ashy.vercel.app/home

# Production example:
# VITE_API_BASE_URL=https://oxxila-api-01ced6342147.herokuapp.com/api/v1
