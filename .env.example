# Dev uses Vite proxy (/api/v1) to avoid CORS. Restart `npm run dev` after changing this.
VITE_API_BASE_URL=/api/v1

# OAuth note: the API redirects back to /login with ?accessToken=... or ?error=...
# Ask the backend team to set FRONTEND_URL to http://localhost:5173 for local OAuth testing.

# Production example:
# VITE_API_BASE_URL=https://oxxila-api-01ced6342147.herokuapp.com/api/v1
