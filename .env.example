# Same-origin API path — proxied in dev (Vite) and on Vercel (vercel.json rewrites).
VITE_API_BASE_URL=/api/v1

# Dev-only: force Returns UI preview data when the API returns no rows.
# Prefer `?preview=true` on /returns or /returns/history instead.
# Ignored in production builds.
# VITE_ENABLE_RETURNS_PREVIEW=true

# Production admin dashboard: https://dash.oxxilapharma.com
# Backend env (Heroku) must redirect OAuth back to this host:
# OAUTH_SUCCESS_REDIRECT=https://dash.oxxilapharma.com/home  (token in URL hash: #accessToken=…)
# OAUTH_FAILURE_REDIRECT=https://dash.oxxilapharma.com/login?error=google_failed
# CORS_ORIGIN must include https://dash.oxxilapharma.com
# CLIENT_URL=https://dash.oxxilapharma.com
